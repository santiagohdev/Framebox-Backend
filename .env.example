# Copiá este archivo como .env y completá los valores.
# El .env real está en .gitignore y nunca se sube.

PORT=4000
NODE_ENV=development

# Base de datos
MONGO_URI=mongodb+srv://usuario:clave@cluster.mongodb.net/framebox

# Sesión. JWT_SECRET tiene que ser una cadena larga y aleatoria:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=12h

# De dónde se aceptan peticiones (CORS)
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:4000

# Verificación de e-mail (Nodemailer)
EMAIL_USER=
EMAIL_PASS=

# API externa de películas
MOVIE_API_URL=
MOVIE_API_KEY=
